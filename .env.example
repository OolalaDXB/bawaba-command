# Bawaba Gateway — Environment Variables
# Copy to .env and fill in production values

# Database
BAWABA_DB_PASSWORD=change-me-in-production

# Agent API Keys (used for X-Bawaba-Key header authentication)
BAWABA_AGENT_KEY_test_agent=test-key-12345
BAWABA_AGENT_KEY_claude_code=claude-key-67890
BAWABA_AGENT_KEY_cursor_ide=cursor-key-11111

# Monitoring (optional, for docker-compose.monitoring.yml)
GRAFANA_PASSWORD=bawaba-admin
